# =========================================================================
# Git Ignore Configuration for California AQI Machine Learning Project
# =========================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Jupyter Notebook Checkpoints & Cache
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# Model training logs & temporary scratch files
catboost_info/
scratch/
tmp/
*.log
*.tmp

# Trained model binaries (Weights > 100MB and PyTorch binaries)
*.joblib
*.pkl
*.pt
*.pth
*.onnx
artifacts/models/*.joblib
artifacts/models/*.pkl
artifacts/models/*.pt
!artifacts/models/.gitkeep

# Local App Databases & Large runtime caches
data/*.db
data/*.sqlite3
data/openmeteo_latest_2026.csv
data/california_aqi_model_ready_extended_2026.csv
data/app_predictions_*.parquet

# Test and coverage artifacts
.pytest_cache/
.coverage
htmlcov/

# Operating System specific
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor configs
.vscode/
.idea/
*.swp
*.swo
